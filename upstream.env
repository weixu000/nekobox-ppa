# Pinned upstream release used by scripts/prepare-source.sh.
# Source-able by bash (no spaces around '=', no shell expansion).
#
# The download is cached in downloads/ (git-ignored) and always verified
# against UPSTREAM_SHA256 before anything is unpacked.
UPSTREAM_VERSION=5.11.28.3
UPSTREAM_TARBALL=nekobox-unified-source-5.11.28.3.tar.xz
UPSTREAM_URL=https://github.com/qr243vbi/nekobox/releases/download/5.11.28.3/nekobox-unified-source-5.11.28.3.tar.xz
UPSTREAM_SHA256=f019166c9cab748e8a8355dddbad7bb527469b18bb5a00b154afd8f9b2342bf8
# Top-level directory inside the release tarball (differs from nekobox-<version>).
UPSTREAM_TOP_DIR=nekobox-unified-source-5.11.28.3
# Release publication timestamp (2026-08-26T18:54:32Z), used as mtime when the
# orig tarball has to be repacked with a Debian-compatible top-level directory.
UPSTREAM_SOURCE_DATE_EPOCH=1787770472

# Debian packaging identity of this repository.
DEBIAN_SOURCE=nekobox
DEBIAN_REVISION=3~ppa1
DEBIAN_DISTRIBUTION=resolute
